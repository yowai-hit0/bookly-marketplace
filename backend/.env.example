# Bookly API — copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# PostgreSQL 15+. The exclusion constraint that prevents double booking
# exists in no other engine (data-model_v2.md §9.1).
DATABASE_URL=postgresql://bookly:bookly@localhost:5432/bookly
# Optional. Direct (unpooled) connection the Prisma CLI migrates through. Set it
# when DATABASE_URL goes through a pooler, e.g. Neon: DATABASE_URL is the
# `-pooler` host, DIRECT_URL the same URL without `-pooler`. Defaults to
# DATABASE_URL.
# DIRECT_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Public origin the site is served from. Emails link here, never at the API host.
WEB_ORIGIN=http://localhost:5173

# Public origin of this API: payment providers call back on it. Required in
# production. For MTN, its host must be the providerCallbackHost of the API user.
# API_ORIGIN=https://api.example.com

# Proxies in front of the API whose X-Forwarded-For is trusted. Every per-IP
# request limit counts the address this resolves to: 1 behind Render alone,
# 2 behind Cloudflare and Render. Check req.ip in the deployed topology.
TRUST_PROXY_HOPS=1

# Payment method routing (docs/marketplace-spec.md R3.1, 2026-10-17). Deploy
# configuration, never a database row. The provider of each payment follows the
# method the client picks:
#   momo_mtn     -> MOMO_MTN_PROVIDER: mtn_momo_direct (default) | flutterwave
#   momo_airtel  -> always flutterwave
#   card         -> always flutterwave_checkout (Flutterwave v3 Inline, below)
# A method is offered only when its provider is configured (the credentials
# below). Switching MOMO_MTN_PROVIDER back is the whole rollback: MTN direct's
# webhook route stays mounted, Flutterwave's while it collects a method or is
# configured, and every configured provider's status lookup keeps running, so
# payments already in flight still settle.
# The retired PAYMENT_PROVIDER is refused at startup unless it is
# mtn_momo_direct, which is ignored; remove it.
MOMO_MTN_PROVIDER=mtn_momo_direct
# Optional: narrow what is offered, a comma list from momo_mtn,momo_airtel,card.
# Unset offers every method whose provider is configured. In production every
# method listed here must be collectable, and unset at least one must be.
# Listing card without the three FLUTTERWAVE_V3_* keys is refused everywhere.
# PAYMENT_METHODS_ENABLED=momo_mtn,momo_airtel,card

# MTN MoMo Collections, direct (plan.md Task 16). Sandbox by default; production
# access depends on R-3. Without all three credentials MTN direct is not
# configured and MTN MoMo is not offered through it; in production a partial set
# is refused. The sandbox never sends callbacks; payments there
# settle through the once-a-minute status lookup. Its currency must be EUR.
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
# MTN_MOMO_SUBSCRIPTION_KEY=
# MTN_MOMO_API_USER=
# MTN_MOMO_API_KEY=
# MTN_MOMO_CURRENCY=EUR

# Flutterwave v4 (plan.md Task 25), MTN MoMo and Airtel Money in Rwanda. Sandbox
# by default; live is https://f4bexperience.flutterwave.com. Client ID and secret
# come from Dashboard > Settings > API keys. Without both, Flutterwave is not
# configured and nothing is offered through it -- Airtel Money included. In
# production the webhook hash is required too whenever Flutterwave collects a
# method.
# FLUTTERWAVE_BASE_URL=https://developersandbox-api.flutterwave.com
# FLUTTERWAVE_IDP_URL=https://idp.flutterwave.com/realms/flutterwave/protocol/openid-connect/token
# FLUTTERWAVE_CLIENT_ID=
# FLUTTERWAVE_CLIENT_SECRET=
# The dashboard's webhook "Secret hash" -- any long random string, set in both
# places. Webhooks go to <API_ORIGIN>/api/webhooks/flutterwave. Without it every
# webhook is stored unverified and payments settle only through the lookup.
# FLUTTERWAVE_WEBHOOK_HASH=
# FLUTTERWAVE_CURRENCY=RWF

# Cards: Flutterwave v3 Inline (the modal on our own pay page; no card number
# ever reaches this server). Set all three or none -- a partial set, or card in
# PAYMENT_METHODS_ENABLED without them, is refused at startup in every
# environment. Test or live is decided by the keys: FLWSECK_TEST-/FLWPUBK_TEST-
# for the sandbox, FLWSECK-/FLWPUBK- for live, never one of each.
#   SECRET_KEY    Dashboard > Settings > API keys > Secret key. Server only.
#   PUBLIC_KEY    Dashboard > Settings > API keys > Public key. Sent to every
#                 payer's browser in the Inline config; never put the secret here.
#   WEBHOOK_HASH  Dashboard > Settings > Webhooks > Secret hash: any long random
#                 string, set in both places. Flutterwave sends it back in the
#                 `verif-hash` header to <API_ORIGIN>/api/webhooks/flutterwave-checkout;
#                 every delivery is still re-verified through the API.
# FLUTTERWAVE_V3_SECRET_KEY=FLWSECK_TEST-replace-me-X
# FLUTTERWAVE_V3_PUBLIC_KEY=FLWPUBK_TEST-replace-me-X
# FLUTTERWAVE_V3_WEBHOOK_HASH=replace-with-a-long-random-string
# FLUTTERWAVE_V3_BASE_URL=https://api.flutterwave.com

# Read once, by `prisma db seed`, to create the single admin_user row
# (data-model_v2.md §13). Not read by the API itself, and not needed to reseed
# an already-seeded database. Change the password after first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-seeding

# Optional. Schema tests run against their own database so they never truncate
# the seeded development one. Defaults to DATABASE_URL with `_test` appended to
# the database name; created automatically on first test run.
# TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/bookly_test

# Optional. Scratch database Prisma creates and drops to replay migration
# history (`migrate dev`, `migrate diff --from-migrations`). Defaults to
# DATABASE_URL with `_shadow` appended.
# SHADOW_DATABASE_URL=postgresql://postgres:password@localhost:5432/bookly_shadow

# HS256 key that signs admin bearer tokens (JWT). At least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it invalidates every issued admin token.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Email (plan.md Stack decisions: a MailProvider interface). Set ONE key:
# RESEND_API_KEY for Resend, or BREVO_API_KEY for Brevo (an `xkeysib-` key from
# Brevo > SMTP & API > API Keys; the key's name in that list is only a label and
# goes nowhere). One is required in production. With neither, in development and
# test, every rendered email is written to MAIL_OUTPUT_DIR instead, so its links
# can be opened.
# RESEND_API_KEY=re_...
# BREVO_API_KEY=xkeysib-...
# The sender. Its address must be a sender or domain verified with the provider.
MAIL_FROM=Bookly <bookings@localhost>
# MAIL_REPLY_TO=photographer@example.com
MAIL_OUTPUT_DIR=.mail

# Optional. "Continue with Google" for clients (Phase 2 decision 6). Create an
# OAuth client of type "Web application" in Google Cloud > APIs & Services >
# Credentials, with the authorised redirect URI <WEB_ORIGIN>/account/google/callback
# (http://localhost:5173/account/google/callback in development). Set both or
# neither; without them the button is hidden and the Google endpoints answer 404.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
