# Bookly web — copy to .env.local and fill in. Never commit .env files.
# Dev: leave as the bare path below — Vite proxies it to Express on localhost.
# Prod: set the full backend URL, e.g. VITE_API_BASE_URL=https://api.bookly.example
# (frontend and backend are two separately-deployed apps on separate domains —
# this is genuinely cross-origin in every deployed environment, spec §7).
VITE_API_BASE_URL=/api
